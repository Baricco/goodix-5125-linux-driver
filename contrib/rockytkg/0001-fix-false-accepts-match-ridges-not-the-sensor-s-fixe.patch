+    if (!f)
+        return;
+    fprintf(f, "P5\n%u %u\n%u\n", w, h, IMGPROC_PX_MAX);
+    for (uint32_t i = 0; i < w * h; i++) {
+        uint16_t v = imgproc_px16(img16le, i);
+        fputc(v >> 8, f);
+        fputc(v & 0xFF, f);
+    }
+    fclose(f);
+}
