From fd9de12bbaa3c5e737c199ceec7548eb8e5ddac8 Mon Sep 17 00:00:00 2001
From: Baricco <38298051+Baricco@users.noreply.github.com>
Date: Sun, 25 Oct 2026 12:52:35 +0100
Subject: [PATCH 2/2] sigfm: ignore correspondences that do not move (sensor
 fixed pattern)

On the Goodix 27c6:5125 (80x64) every frame carries a fixed pattern tied
to the sensor pixels: stripes and blobs left by per-pixel gain and offset
after baseline subtraction. SIFT keypoints of that pattern sit at the same
coordinates in every frame, so they match across different fingers with a
perfectly consistent geometry. On a 20 genuine / 20 impostor set impostors
scored 2,000-13,000 against a threshold of 20; 93% of those
correspondences had a displacement <= 1 px.

Two real presses are never placed with sub-pixel accuracy, so drop
correspondences whose keypoints are within 2 px. Impostor scores went to
0 on every data set, measured live: 0/25 impostors and 22/25 genuine
presses accepted (with the goodixgf ridge image pipeline).

Side effect: an image compared with itself (or a pixel-identical copy) now
scores 0, since all of its correspondences are still.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libfprint/sigfm/sigfm.cpp | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/libfprint/sigfm/sigfm.cpp b/libfprint/sigfm/sigfm.cpp
index c8649aea..09ec8c9f 100644
--- a/libfprint/sigfm/sigfm.cpp
+++ b/libfprint/sigfm/sigfm.cpp
@@ -52,6 +52,15 @@ constexpr auto distance_match = 0.75;
 constexpr auto length_match = 0.05;
 constexpr auto angle_match = 0.05;
 constexpr auto min_match = 5;
+// Correspondences whose two keypoints sit at (almost) the same sensor pixel
+// are discarded. Sensor fixed-pattern artefacts (per-pixel/column gain and
+// offset residue left after baseline subtraction) are locked to the pixel
+// grid, so they show up in every frame at identical coordinates and match
+// each other across *different* fingers with a perfectly consistent
+// geometry: on small area sensors this produced huge scores for impostor
+// frames. Two real impressions of a finger are never placed with sub-pixel
+// accuracy, so real ridge correspondences always carry some displacement.
+constexpr auto min_displacement = 2.0;
 struct match {
     cv::Point2i p1;
     cv::Point2i p2;
@@ -135,9 +144,11 @@ int sigfm_match_score(SigfmImgInfo* frame, SigfmImgInfo* enrolled)
             }
             const cv::DMatch& match_1 = pts.at(0);
             if (match_1.distance < distance_match * pts.at(1).distance) {
-                matches_unique.emplace(
-                    match{frame->keypoints.at(match_1.queryIdx).pt,
-                          enrolled->keypoints.at(match_1.trainIdx).pt});
+                const cv::Point2f& kp1 = frame->keypoints.at(match_1.queryIdx).pt;
+                const cv::Point2f& kp2 = enrolled->keypoints.at(match_1.trainIdx).pt;
+                if (cv::norm(kp1 - kp2) <= min_displacement)
+                    continue;
+                matches_unique.emplace(match{kp1, kp2});
                 nb_matched++;
             }
         }
