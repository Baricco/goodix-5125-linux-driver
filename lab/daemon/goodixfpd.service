[Unit]
Description=Goodix 27c6:5125 fingerprint authentication daemon
Documentation=file:///docs/pam-integration.md
# Starts when the sensor is present (udev rule that tags systemd).
After=systemd-udevd.service

[Service]
Type=simple
# Dedicated system user (to create it: see docs/pam-integration.md). It does NOT run as root:
# it reaches the sensor only through the 'goodixfp' group (udev rule 70-goodixfp.rules).
User=goodixfp
Group=goodixfp
SupplementaryGroups=goodixfp

# Repository path (contains lab/, goodix-fp-dump/).
# Adapt WorkingDirectory/GOODIXFP_REPO to the real installation.
WorkingDirectory=/opt/goodix-driver
Environment=GOODIXFP_REPO=/opt/goodix-driver
Environment=GOODIXFP_STATE=/var/lib/goodixfp
Environment=GOODIXFP_SOCKET=/run/goodixfpd/sock
ExecStart=/opt/goodix-driver/tools/.venv/bin/python /opt/goodix-driver/lab/daemon/goodixfpd.py

# /run/goodixfpd created with group goodixfp -> the 0660 socket is reachable by root (PAM).
RuntimeDirectory=goodixfpd
RuntimeDirectoryMode=0750
StateDirectory=goodixfp
StateDirectoryMode=0750

# Hardening: the daemon talks only USB + a local socket, no network.
RestartSec=2
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateNetwork=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_UNIX for the socket, AF_NETLINK because libusb uses it to enumerate/hotplug.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# USB sensor access: left to the udev rule (GROUP=goodixfp), NOT to the device cgroup.
# A DeviceAllow that is too strict here would deny /dev/bus/usb and the daemon would not see the sensor.

[Install]
WantedBy=multi-user.target
