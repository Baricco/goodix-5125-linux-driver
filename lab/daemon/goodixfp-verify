#!/usr/bin/env python3
"""PAM client for goodixfpd. Asks the daemon to verify the user and returns 0 (success) / 1.

Meant for pam_exec: the user arrives in PAM_USER. Alternatively it is passed as an argument.
It prints NOTHING sensitive; a short "Touch the sensor" prompt goes to stderr.

It exits 0 only if the daemon replies {"ok": true}. Any error/timeout -> 1 (PAM goes on with the
password thanks to 'sufficient'): the sensor must never lock the user out.
"""
import json
import os
import socket
import sys
import time

SOCKET_PATH = os.environ.get("GOODIXFP_SOCKET", "/run/goodixfpd/sock")
TIMEOUT = float(os.environ.get("GOODIXFP_CLIENT_TIMEOUT", "12"))
CONNECT_RETRY = float(os.environ.get("GOODIXFP_CONNECT_RETRY", "3"))  # the daemon may be starting


def main():
    user = sys.argv[1] if len(sys.argv) > 1 else os.environ.get("PAM_USER", "")
    if not user:
        return 1
    # Retry the connection for a few seconds: at startup/boot the daemon may not have bound the
    # socket yet (Type=simple). If it is really not there, return 1 -> password fallback.
    deadline = time.time() + CONNECT_RETRY
    s = None
    while True:
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(TIMEOUT)
            s.connect(SOCKET_PATH)
            break
        except OSError:
            if s is not None:
                s.close()
            if time.time() >= deadline:
                return 1
            time.sleep(0.2)
    # Under pam_exec stderr does not reach the terminal: the prompt is written to /dev/tty (the
    # controlling terminal), so the user KNOWS when to press. Fallback to stderr without a tty.
    try:
        _tty = open("/dev/tty", "w")
    except OSError:
        _tty = sys.stderr
    try:
        _tty.write("Place your finger on the reader (still and firm)...\n")
        _tty.flush()
        s.sendall((json.dumps({"op": "verify", "user": user}) + "\n").encode())
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(4096)
            if not chunk:
                return 1
            buf += chunk
        res = json.loads(buf.split(b"\n", 1)[0].decode())
        if res.get("ok"):
            _tty.write("  fingerprint recognized.\n")
            _tty.flush()
            return 0
        if res.get("reason"):
            _tty.write(f"  ({res['reason']})\n")
            _tty.flush()
        return 1
    except (OSError, ValueError):
        return 1
    finally:
        s.close()


if __name__ == "__main__":
    sys.exit(main())
