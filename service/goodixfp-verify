#!/usr/bin/env python3
"""Client PAM per goodixfpd. Chiede la verify dell'utente al demone e ritorna 0 (successo) / 1.

Pensato per pam_exec: l'utente arriva in PAM_USER. In alternativa si passa come argomento.
NON stampa nulla di sensibile; un breve invito "Tocca il sensore" va su stderr.

Esce 0 solo se il demone risponde {"ok": true}. Qualunque errore/timeout -> 1 (PAM prosegue
con la password grazie a 'sufficient'): il sensore non deve mai chiudere fuori l'utente.
"""
import json
import os
import socket
import sys
import time

SOCKET_PATH = os.environ.get("GOODIXFP_SOCKET", "/run/goodixfpd/sock")
TIMEOUT = float(os.environ.get("GOODIXFP_CLIENT_TIMEOUT", "12"))
CONNECT_RETRY = float(os.environ.get("GOODIXFP_CONNECT_RETRY", "3"))  # il demone puo' star partendo


def main():
    user = sys.argv[1] if len(sys.argv) > 1 else os.environ.get("PAM_USER", "")
    if not user:
        return 1
    # Riprova la connessione per qualche secondo: all'avvio/boot il demone puo' non aver ancora
    # fatto bind del socket (Type=simple). Se proprio non c'e', torna 1 -> fallback password.
    deadline = time.time() + CONNECT_RETRY
    s = None
    while True:
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(TIMEOUT)
            s.connect(SOCKET_PATH)
            break
        except OSError:
            if s is not None:
                s.close()
            if time.time() >= deadline:
                return 1
            time.sleep(0.2)
    try:
        sys.stderr.write("Tocca il sensore d'impronta...\n")
        sys.stderr.flush()
        s.sendall((json.dumps({"op": "verify", "user": user}) + "\n").encode())
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(4096)
            if not chunk:
                return 1
            buf += chunk
        res = json.loads(buf.split(b"\n", 1)[0].decode())
        if not res.get("ok") and res.get("reason"):
            sys.stderr.write(f"  ({res['reason']})\n")
        return 0 if res.get("ok") else 1
    except (OSError, ValueError):
        return 1
    finally:
        s.close()


if __name__ == "__main__":
    sys.exit(main())
