// goodix-driver — keyring-tpm (optional).
// Lets @USER@ decrypt system credentials (systemd-creds) without interactive
// authentication. Needed to unlock the keyring via TPM at login, when the
// session is not yet "active" for polkit and there is no agent
// (otherwise: io.systemd.InteractiveAuthenticationRequired).
//
// Security note: on a single-user machine where the user already has sudo this
// is not a real escalation. On multi-user systems consider restricting or
// avoiding it.
polkit.addRule(function(action, subject) {
    if (action.id == "io.systemd.credentials.decrypt" &&
        subject.user == "@USER@") {
        return polkit.Result.YES;
    }
});
