# goodixfpd: answers instead of fprintd for the Goodix 27c6:5125/5135 reader.
# Same service, same D-Bus interface, same protection as fprintd.service;
# if the reader is not present, goodixfpd starts the real fprintd.
# Useful variables (an additional drop-in with Environment=):
#   GOODIX_LEARN=0    do not let fingerprints grow with use
#   GOODIX_MIN_RIDGE  minimum contrast of touches (default 10)
[Service]
ExecStart=
ExecStart=@libexecdir@/goodixfpd
