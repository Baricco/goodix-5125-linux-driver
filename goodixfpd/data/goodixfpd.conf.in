# goodixfpd: risponde al posto di fprintd per il lettore Goodix 27c6:5125/5135.
# Stesso servizio, stessa interfaccia D-Bus, stessa protezione di
# fprintd.service; se il lettore non c'e', goodixfpd avvia il vero fprintd.
# Variabili utili (drop-in aggiuntivo con Environment=):
#   GOODIX_LEARN=0    non far crescere le impronte durante l'uso
#   GOODIX_MIN_RIDGE  contrasto minimo dei tocchi (default 10)
[Service]
ExecStart=
ExecStart=@libexecdir@/goodixfpd
