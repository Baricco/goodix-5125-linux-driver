# Package of the goodixfpd service (Goodix 27c6:5125/5135 reader).
#
# No library is modified: libfprint and fprintd stay the distribution's
# official ones. goodixfpd takes the place of fprintd's daemon through a
# drop-in for fprintd.service and speaks the same D-Bus interface; if the
# reader is not present it starts the real fprintd.
#
# Built from the sources of this repository:
#   cd packaging/goodixfpd && makepkg -si

pkgname=goodixfpd
pkgver=0.1.0
pkgrel=2
pkgdesc="Fingerprint service for the Goodix 27c6:5125/5135 reader, compatible with fprintd"
arch=(x86_64)
license=(GPL-2.0-or-later)
depends=(
  fprintd       # pam_fprintd, fprintd-*, D-Bus interface and polkit rules
  libfprint     # the official one: fprintd needs it on other machines
  glib2
  libusb
  openssl
  polkit
)
makedepends=(meson gcc pkgconf)
checkdepends=(dbus python-gobject python-numpy)
conflicts=(libfprint-goodixgf)
install=goodixfpd.install
source=(goodixfpd.hook goodixfpd-check)
sha256sums=('SKIP' 'SKIP')

_src="$startdir/../../goodixfpd"

build() {
  arch-meson "$_src" build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 goodixfpd.hook "$pkgdir/usr/share/libalpm/hooks/goodixfpd.hook"
  install -Dm755 goodixfpd-check "$pkgdir/usr/share/goodixfpd/goodixfpd-check"
}
