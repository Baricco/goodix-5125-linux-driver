#!/bin/sh
# Run by the pacman hook after every transaction (read only).
# goodixfpd modifies no library: the only way an update can break it is a new
# binary version (soname) of one of its dependencies, for example OpenSSL 4.
# In that case the reader stops, but sudo and login ask for the password as
# usual.
bin=/usr/lib/goodixfpd
missing=$(ldd "$bin" 2>/dev/null | awk '/not found/ {printf "%s ", $1}')
[ -z "$missing" ] && exit 0
echo "!! goodixfpd no longer loads: missing $missing"
echo "   The reader is stopped, the password works. Rebuild the package:"
echo "   cd <goodix-driver repo>/packaging/goodixfpd && makepkg -sif"
exit 0
