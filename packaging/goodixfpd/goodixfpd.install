post_install() {
  systemctl daemon-reload >/dev/null 2>&1
  # the old libfprint-goodixgf package left the warm-up enabled:
  # goodixfpd now does it by itself
  rm -f /etc/systemd/system/multi-user.target.wants/goodixgf-warmup.service
  systemctl try-restart fprintd.service >/dev/null 2>&1
  echo ">> goodixfpd installed: it answers instead of fprintd for the Goodix reader."
  echo "   Fingerprints enrolled with libfprint-goodixgf are no longer valid:"
  echo "   enroll them again with  fprintd-enroll  or with the project's GUI."
}

post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1
  systemctl try-restart fprintd.service >/dev/null 2>&1
}

post_remove() {
  # without the drop-in the distribution's fprintd comes back
  systemctl daemon-reload >/dev/null 2>&1
  systemctl try-restart fprintd.service >/dev/null 2>&1
}
