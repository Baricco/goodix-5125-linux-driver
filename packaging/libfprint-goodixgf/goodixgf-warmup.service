[Unit]
Description=Goodix 27c6:5125 cold-boot baseline reset (finger-detect warm-up)
# Al boot il sensore e' freddo: le soglie di finger-detect salvate da una
# sessione calda non scattano piu' al greeter. Cancellando la baseline, il
# driver la ricampiona a freddo (senza dito) alla prima apertura di fprintd.
Before=fprintd.service greetd.service display-manager.service
ConditionPathExists=/var/lib/fprint/goodix/goodix.dat

[Service]
Type=oneshot
ExecStart=/usr/bin/rm -f /var/lib/fprint/goodix/goodix.dat

[Install]
WantedBy=multi-user.target
