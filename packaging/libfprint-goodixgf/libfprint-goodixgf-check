#!/bin/sh
# Lanciato dall'hook di pacman dopo ogni transazione (sola lettura).
#  1. la libreria si carica ancora? Una dipendenza (opencv, mbedtls, ...)
#     aggiornata a una versione incompatibile la lascia senza le sue .so;
#  2. la distribuzione ha pubblicato una libfprint diversa da quella su cui
#     e' allineato il pacchetto? Nuova versione upstream o nuovo pkgrel (le
#     correzioni di sicurezza su una stessa versione arrivano come pkgrel).
lib=/usr/lib/libfprint-2.so.2.0.0
missing=$(ldd "$lib" 2>/dev/null | awk '/not found/ {printf "%s ", $1}')
if [ -n "$missing" ]; then
  echo "!! libfprint-goodixgf non si carica piu': mancano $missing"
  echo "   Una dipendenza ha cambiato versione: il lettore e' fermo, la password funziona."
  echo "   Ricompila dalla cartella del progetto:  packaging/goodixgf-update"
fi

repo=$(LC_ALL=C pacman -Si libfprint 2>/dev/null | awk '/^Version/ {print $3; exit}')
base=$(cat /usr/share/libfprint-goodixgf/base-version 2>/dev/null)
[ -n "$repo" ] && [ -n "$base" ] || exit 0
if [ "$(vercmp "$repo" "$base")" -gt 0 ]; then
  echo ">> La distribuzione ha aggiornato libfprint: $base -> $repo"
  echo "   (puo' contenere correzioni di sicurezza). Allinea libfprint-goodixgf"
  echo "   dalla cartella del progetto:  packaging/goodixgf-update"
fi
exit 0
