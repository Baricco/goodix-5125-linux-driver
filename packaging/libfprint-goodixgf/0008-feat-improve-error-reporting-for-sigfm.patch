From 7f298128b33892c49adcfdcdaae3228bceb3e3c9 Mon Sep 17 00:00:00 2001
From: Natasha England-Elbro <natasha@natashaee.me>
Date: Sat, 5 Nov 2022 22:28:58 +0000
Subject: [PATCH 08/21] feat: improve error reporting for sigfm

---
 libfprint/fp-print.c  | 2 ++
 libfprint/fpi-print.c | 6 ++++++
 2 files changed, 8 insertions(+)

diff --git a/libfprint/fp-print.c b/libfprint/fp-print.c
index a2651972..85f60963 100644
--- a/libfprint/fp-print.c
+++ b/libfprint/fp-print.c
@@ -921,6 +921,8 @@ fp_print_deserialize (const guchar *data,
             g_variant_unref (child);
 
             SfmImgInfo * sfm_info = sfm_deserialize_binary (serialized, slen);
+            if (!sfm_info)
+              goto invalid_format;
 
             g_ptr_array_add (result->prints, g_steal_pointer (&sfm_info));
           }
diff --git a/libfprint/fpi-print.c b/libfprint/fpi-print.c
index 9b97ee21..687ef00f 100644
--- a/libfprint/fpi-print.c
+++ b/libfprint/fpi-print.c
@@ -303,6 +303,12 @@ fpi_print_sfm_match (FpPrint * template, FpPrint * print,
     {
       SfmImgInfo * pinfo = g_ptr_array_index (template->prints, i);
       int score = sfm_match_score (pinfo, against);
+      if (score < 0)
+        {
+          *error = fpi_device_error_new_msg (FP_DEVICE_ERROR_DATA_INVALID,
+                                             "error in sfm_match_score");
+          return FPI_MATCH_ERROR;
+        }
       fp_dbg ("sfm score %d/%d", score, bz3_threshold);
       if (score >= bz3_threshold)
         return FPI_MATCH_SUCCESS;
