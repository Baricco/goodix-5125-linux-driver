prepare() {
  cd libfprint
  local p
  for p in "${source[@]}"; do
    [[ $p == *.patch ]] || continue
    echo "  -> $p"
    patch -Np1 -i "$srcdir/$p"
  done
}

build() {
  local meson_options=(
    -D drivers=all
    -D installed-tests=false
  )

  arch-meson libfprint build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 goodixgf-warmup.service \
    "$pkgdir/usr/lib/systemd/system/goodixgf-warmup.service"
  install -Dm644 fprintd-goodixgf.conf \
    "$pkgdir/usr/lib/systemd/system/fprintd.service.d/goodixgf.conf"
  install -Dm644 libfprint-goodixgf.hook \
    "$pkgdir/usr/share/libalpm/hooks/libfprint-goodixgf.hook"
  install -Dm755 libfprint-goodixgf-check \
    "$pkgdir/usr/share/libfprint-goodixgf/libfprint-goodixgf-check"
}

