# libfprint ufficiale + SIGFM (merge request upstream !530) + driver goodixgf
# per i lettori Goodix 27c6:5125 / 27c6:5135 (Huawei/Honor, sensore nel tasto
# di accensione). Sostituisce il pacchetto libfprint: fprintd e pam_fprintd
# restano quelli della distribuzione.
#
# Aggiornare a una nuova libfprint upstream: cambia _upstream (o usa
# ../goodixgf-update), poi `makepkg -si`. Le patch *.patch qui accanto sono
# esportate dal ramo goodixgf-<versione> con `git format-patch v<versione>..`.

pkgname=libfprint-goodixgf
_upstream=1.94.100
pkgver=${_upstream}
pkgrel=2
pkgdesc="Library for fingerprint readers, with SIGFM and the goodixgf driver (Goodix 27c6:5125/5135)"
url="https://fprint.freedesktop.org/"
