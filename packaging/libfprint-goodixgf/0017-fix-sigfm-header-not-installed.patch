From 268048c20bee2f7d08c3620679bf73ae1ee6571a Mon Sep 17 00:00:00 2001
From: Natasha England-Elbro <natasha@natashaee.me>
Date: Sun, 19 Mar 2023 17:42:17 +0000
Subject: [PATCH 17/21] fix: sigfm header not installed

Co-authored-by: Lorenz Brun
---
 libfprint/meson.build | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/libfprint/meson.build b/libfprint/meson.build
index 9d88e402..b0c909cc 100644
--- a/libfprint/meson.build
+++ b/libfprint/meson.build
@@ -295,6 +295,9 @@ libfprint_dep = declare_dependency(link_with: libfprint,
 install_headers(['fprint.h'] + libfprint_public_headers,
     subdir: versioned_libname
 )
+install_headers(['sigfm/sigfm.h'],
+  subdir: versioned_libname + '/sigfm'
+)
 
 libfprint_private_dep = declare_dependency(
     include_directories: include_directories('.'),
