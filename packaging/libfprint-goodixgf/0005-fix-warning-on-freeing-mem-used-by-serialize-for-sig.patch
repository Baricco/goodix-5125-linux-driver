From 96c6c0c0ea03cf37c1bfce4e7daac515956ecb77 Mon Sep 17 00:00:00 2001
From: Natasha England-Elbro <natasha@natashaee.me>
Date: Fri, 20 Jan 2023 13:32:32 +0000
Subject: [PATCH 05/21] fix: warning on freeing mem used by serialize for sigfm

---
 libfprint/fp-print.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/libfprint/fp-print.c b/libfprint/fp-print.c
index 4c45c31d..a2651972 100644
--- a/libfprint/fp-print.c
+++ b/libfprint/fp-print.c
@@ -683,7 +683,7 @@ fp_print_serialize (FpPrint *print,
   g_variant_builder_open (&builder, G_VARIANT_TYPE_VARDICT);
   g_variant_builder_close (&builder);
 
-  GPtrArray * to_free = g_ptr_array_new ();
+  GPtrArray * to_free = NULL;
 
   /* Insert NBIS print data for type NBIS, otherwise the GVariant directly */
   if (print->type == FPI_PRINT_NBIS)
@@ -721,6 +721,8 @@ fp_print_serialize (FpPrint *print,
     }
   else if (print->type == FPI_PRINT_SIGFM)
     {
+      to_free = g_ptr_array_new ();
+      g_ptr_array_set_free_func (to_free, free);
       GVariantBuilder nested =
         G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE ("(a(ay))"));
       g_variant_builder_open (&nested, G_VARIANT_TYPE ("a(ay)"));
@@ -766,7 +768,8 @@ fp_print_serialize (FpPrint *print,
 
   g_variant_get_data (result);
   g_variant_store (result, (*data) + 3);
-  g_clear_object (&to_free);
+  if (to_free != NULL)
+    g_ptr_array_free (to_free, TRUE);
 
   return TRUE;
 }
