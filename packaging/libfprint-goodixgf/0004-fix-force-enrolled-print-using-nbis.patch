From 40fa0366114b8afbb717410212d6d0d81b1f4a1b Mon Sep 17 00:00:00 2001
From: Natasha England-Elbro <natasha@natashaee.me>
Date: Sun, 22 Jan 2023 12:10:44 +0000
Subject: [PATCH 04/21] fix: force enrolled print using nbis

---
 libfprint/fp-image-device.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/libfprint/fp-image-device.c b/libfprint/fp-image-device.c
index e4c839ed..812b7481 100644
--- a/libfprint/fp-image-device.c
+++ b/libfprint/fp-image-device.c
@@ -125,9 +125,10 @@ fp_image_device_start_capture_action (FpDevice *device)
       FpPrint *enroll_print = NULL;
 
       fpi_device_get_enroll_data (device, &enroll_print);
+      FpiPrintType print_type;
       g_object_get (enroll_print, "fpi-type", &print_type, NULL);
-      if (print_type != FPI_PRINT_NBIS)
-        fpi_print_set_type (enroll_print, FPI_PRINT_NBIS);
+      if (print_type != priv->algorithm)
+        fpi_print_set_type (enroll_print, priv->algorithm);
     }
 
   priv->enroll_stage = 0;
