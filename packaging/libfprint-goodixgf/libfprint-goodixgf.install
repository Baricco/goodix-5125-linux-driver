post_install() {
  systemctl daemon-reload >/dev/null 2>&1
  systemctl try-restart fprintd.service >/dev/null 2>&1
  echo ">> libfprint-goodixgf installata."
  echo "   Warm-up al boot (consigliato):  sudo systemctl enable goodixgf-warmup.service"
  echo "   Registra l'impronta:            fprintd-enroll  (oppure la GUI del progetto)"
  echo "   Se avevi impronte registrate con un'altra build del driver, registrale di nuovo."
}

post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1
  systemctl try-restart fprintd.service >/dev/null 2>&1
}

post_remove() {
  systemctl daemon-reload >/dev/null 2>&1
}
