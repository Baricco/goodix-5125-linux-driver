From 5489b3446625ae5b1ba48c6856537c17e6264576 Mon Sep 17 00:00:00 2001
From: Matthieu CHARETTE <matthieu.charette@gmail.com>
Date: Sat, 19 Nov 2022 15:49:10 +0100
Subject: [PATCH 12/21] fix: Add a minimum keypoint count

---
 libfprint/fp-image.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libfprint/fp-image.c b/libfprint/fp-image.c
index 3bf17d2f..b72dc647 100644
--- a/libfprint/fp-image.c
+++ b/libfprint/fp-image.c
@@ -320,10 +320,10 @@ fp_image_sigfm_extract_thread_func (GTask * task, void * src_obj,
   g_timer_stop (timer);
   fp_dbg ("sigfm extract completed in %f secs", g_timer_elapsed (timer, NULL));
   g_timer_destroy (timer);
-  if (sigfm_keypoints_count (data->sigfm_info) == 0)
+  if (sigfm_keypoints_count (data->sigfm_info) < 25)
     {
       g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED,
-                               "No keypoints found");
+                               "No enough keypoints found");
       g_object_unref (task);
       return;
     }
