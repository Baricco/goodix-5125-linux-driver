#!/usr/bin/env bash
# Allinea libfprint-goodixgf alla libfprint dei repo e la installa.
#
#   packaging/goodixgf-update            aggiorna se serve, poi makepkg -Csi
#   packaging/goodixgf-update --force    ricompila anche se e' gia' allineato
#
# Segue il pacchetto libfprint della distribuzione:
#  - nuova versione upstream -> porta _upstream alla nuova versione;
#  - nuovo pkgrel (correzioni su una stessa versione) -> importa le correzioni
#    del PKGBUILD ufficiale Arch per quella versione: file patch (dal .SRCINFO)
#    e commit upstream presi con `git cherry-pick` (estratti dal testo del
#    PKGBUILD, mai eseguito) e le applica prima delle nostre;
#  - libreria che non si carica piu' (opencv/mbedtls aggiornati) -> ricompila.
# Se una patch non si applica la build si ferma e resta installata la
# versione attuale (il lettore continua a funzionare).
set -euo pipefail

PKG="$(cd "$(dirname "$0")" && pwd)/libfprint-goodixgf"
ARCH_PKG=https://gitlab.archlinux.org/archlinux/packaging/packages/libfprint/-/raw

repo=$(LC_ALL=C pacman -Si libfprint | awk '/^Version/ {print $3; exit}')   # es. 1.94.100-1.1
repo_ver=${repo%-*}
repo_rel=${repo##*-}
arch_tag="$repo_ver-${repo_rel%%.*}"          # CachyOS ricompila Arch come <pkgrel>.N
cur_up=$(sed -n 's/^_upstream=//p' "$PKG/PKGBUILD")
cur_distro=$(sed -n 's/^_distrover=//p' "$PKG/PKGBUILD")
cur_rel=$(sed -n 's/^pkgrel=//p' "$PKG/PKGBUILD")
inst=$(LC_ALL=C pacman -Q libfprint-goodixgf 2>/dev/null | awk '{print $2}' || true)
broken=0
ldd /usr/lib/libfprint-2.so.2.0.0 2>/dev/null | grep -q "not found" && broken=1
echo "libfprint nei repo: $repo   allineato a: $cur_distro   installata: ${inst:-nessuna}"

if [ "$(vercmp "$repo" "$cur_distro")" -gt 0 ]; then
  echo ">> allineo a $repo (patch ufficiali Arch dal tag $arch_tag)"
  srcinfo=$(curl -fsSL "$ARCH_PKG/$arch_tag/.SRCINFO") || {
    echo "!! .SRCINFO Arch per $arch_tag non trovato: allineo solo la versione" >&2
    srcinfo=""
  }
  rm -f "$PKG"/distro-*.patch
  list=""
  while read -r src; do
    [ -n "$src" ] || continue
    case "$src" in git+*|*://*) continue ;; esac
    if [[ ! $src =~ ^[A-Za-z0-9._-]+\.(patch|diff)$ ]]; then
      echo "!! il PKGBUILD ufficiale usa un sorgente extra ($src): controllalo a mano" >&2
      continue
    fi
    curl -fsSL "$ARCH_PKG/$arch_tag/$src" -o "$PKG/distro-$src"
    list+="distro-$src "
    echo "   + patch della distribuzione: $src"
  done < <(printf '%s\n' "$srcinfo" | sed -n 's/^\tsource = //p')

  picks=$(curl -fsSL "$ARCH_PKG/$arch_tag/PKGBUILD" 2>/dev/null |
          grep -oE 'git cherry-pick( -[a-z]+)* [0-9a-f]{7,40}' | grep -oE '[0-9a-f]{7,40}$' | tr '\n' ' ' || true)
  [ -n "$picks" ] && echo "   + commit upstream presi dalla distribuzione: $picks"

  if [ "$(vercmp "$repo_ver" "$cur_up")" -gt 0 ]; then
    rel=1
  else
    rel=$((cur_rel + 1))
  fi
  sed -i "s/^_upstream=.*/_upstream=$repo_ver/; s/^_distrover=.*/_distrover=$repo/;
          s/^_distro_patches=.*/_distro_patches=(${list% })/; s/^_distro_cherrypicks=.*/_distro_cherrypicks=(${picks% })/;
          s/^pkgrel=.*/pkgrel=$rel/" "$PKG/PKGBUILD"
  (
    cd "$PKG"
    sums=$(makepkg -g 2>/dev/null)
    python3 - "$sums" <<'EOF'
import re, sys
p = 'PKGBUILD'
s = open(p).read()
s = re.sub(r"sha256sums=\([^)]*\)", sys.argv[1], s, count=1)
open(p, 'w').write(s)
EOF
  )
elif [ "${1:-}" != "--force" ] && [ -n "$inst" ] && [ $broken -eq 0 ]; then
  echo "gia' allineato."
  exit 0
fi

cd "$PKG"
if ! makepkg -Csif --noconfirm; then
  echo "!! build fallita (patch non applicabili su $repo?): resta installata ${inst:-la versione precedente}." >&2
  echo "   Ripristina il PKGBUILD con:  git checkout packaging/libfprint-goodixgf" >&2
  echo "   Correzione di sicurezza urgente:  sudo pacman -S libfprint" >&2
  echo "   (libfprint ufficiale: lettore fermo, password ok, finche' le patch non sono aggiornate)" >&2
  exit 1
fi
echo ">> installata libfprint-goodixgf allineata a libfprint $(sed -n 's/^_distrover=//p' PKGBUILD)"
